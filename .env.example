# Copy this file to .env and adjust as needed. Everything below is optional on Windows.

# The .minecraft folder on your computer.
# Windows (default if not set): %APPDATA%\.minecraft
#   MINECRAFT_DIR=C:/Users/YourName/AppData/Roaming/.minecraft
# Linux:  MINECRAFT_DIR=/home/user/.minecraft
# macOS:  MINECRAFT_DIR=/Users/user/Library/Application Support/minecraft
# MINECRAFT_DIR=

# Initial settings values (changed later on the "Settings" page)
MC_VERSION=26.3
MC_LOADER=neoforge
PROVIDER=MODRINTH
# Only needed for CurseForge: https://console.curseforge.com
CURSEFORGE_API_KEY=

# Web UI port
WEB_PORT=4200
