# Скопіюйте цей файл у .env і змініть за потреби. Усе нижче необов'язкове на Windows.

# Папка .minecraft на вашому комп'ютері.
# Windows (за замовчуванням, якщо не задано): %APPDATA%\.minecraft
#   MINECRAFT_DIR=C:/Users/ВашеІм'я/AppData/Roaming/.minecraft
# Linux:  MINECRAFT_DIR=/home/user/.minecraft
# macOS:  MINECRAFT_DIR=/Users/user/Library/Application Support/minecraft
# MINECRAFT_DIR=

# Початкові значення налаштувань (потім змінюються на сторінці «Налаштування»)
MC_VERSION=26.3
MC_LOADER=neoforge
PROVIDER=MODRINTH
# Ключ потрібен лише для CurseForge: https://console.curseforge.com
CURSEFORGE_API_KEY=

# Порт веб-інтерфейсу та пароль до Postgres
WEB_PORT=4200
DB_PASSWORD=mcmanager
